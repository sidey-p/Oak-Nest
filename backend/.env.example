PORT=5000

# Supabase Postgres — use the Connection Pooler settings from
# Project Settings -> Database -> Connection string -> URI (pooler tab).
# Direct connections use port 5432; the pooler uses port 6543.
# Your project's pooler host (ap-south-1):
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.cdjigtcrbfarbfisjtgu
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
DB_NAME=postgres
DB_SSL=true

JWT_SECRET=replace_with_a_long_random_local_secret
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173
